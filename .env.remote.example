# Public hostname. Create a DNS A/AAAA record pointing this name at the server first.
ASSISTANT_DOMAIN=assistant.example.com
ASSISTANT_WEB_USER=assistant
# Generate with: docker run --rm -it caddy:2.10-alpine caddy hash-password
# Keep the bcrypt value single-quoted so Docker Compose does not expand its $ characters.
ASSISTANT_WEB_PASSWORD_HASH='$2a$14$replace_with_a_real_caddy_hash'

# Use URL-safe values such as: openssl rand -hex 32
ASSISTANT_POSTGRES_PASSWORD=replace_with_a_random_hex_value
ASSISTANT_APPROVAL_TOKEN=replace_with_a_different_random_hex_value

# Routine model providers. Configure one or both.
KIMI_API_KEY=
MINIMAX_API_KEY=
ASSISTANT_CONVERSATION_MODEL_PROVIDER=minimax
ASSISTANT_CONVERSATION_MODEL_FALLBACK_PROVIDER=auto

# Gemini is used only for optional TTS.
GEMINI_TTS_API_KEY=

# Optional manager-model analysis.
ASSISTANT_MANAGER_MODEL_ENABLED=false
ASSISTANT_MANAGER_MODEL_PROVIDER=kimi
ASSISTANT_MANAGER_MODEL_FALLBACK_PROVIDER=auto

# Optional GitHub PR workflow. Keep code execution disabled until the remote worker
# has a target repository and Codex runtime mounted/configured.
ASSISTANT_REPOSITORIES_DIRECTORY=/service/repositories
ASSISTANT_WORKFLOWS_DIRECTORY=/service/workflows
ASSISTANT_DEFAULT_REPOSITORY_ID=personal-assistant
ASSISTANT_REPOSITORY_PERSONAL_ASSISTANT_PATH=
ASSISTANT_REPOSITORY_ANALYTICS_AGENT_PLAYGROUND_PATH=
ASSISTANT_GITHUB_TOKEN=
ASSISTANT_GITHUB_REPOSITORY=
ASSISTANT_GITHUB_BASE_BRANCH=main
ASSISTANT_GITHUB_REMOTE=origin
ASSISTANT_GITHUB_DRAFT_PULL_REQUESTS=true
ASSISTANT_CODE_AGENT_ENABLED=false
ASSISTANT_CODE_AGENT_PROVIDERS=kimi,minimax-claude,codex
ASSISTANT_KIMI_CODE_EXECUTABLE=kimi
ASSISTANT_KIMI_CODE_MODEL=
ASSISTANT_CLAUDE_CODE_EXECUTABLE=claude
ASSISTANT_MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ASSISTANT_MINIMAX_CODE_MODEL=
ASSISTANT_CODE_AGENT_RATE_LIMIT_COOLDOWN_SECONDS=300
ASSISTANT_CODE_AGENT_QUOTA_COOLDOWN_SECONDS=3600
ASSISTANT_CODE_REPOSITORY_PATH=
