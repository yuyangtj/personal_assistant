FROM node:22-bookworm-slim AS node-runtime

FROM python:3.13-slim

ARG KIMI_CODE_VERSION=2.0.2
ARG CLAUDE_CODE_VERSION=2.1.280

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp/assistant-home

COPY --from=node-runtime /usr/local /usr/local

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git openssh-client \
    && node --version \
    && npm install --global \
        "@moonshot-ai/kimi-code@${KIMI_CODE_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && python -m pip install --no-cache-dir uv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /service
COPY pyproject.toml README.md ./
COPY app ./app
COPY capabilities ./capabilities
COPY repositories ./repositories
COPY workflows ./workflows
COPY coding-runners ./coding-runners
COPY validation-profiles ./validation-profiles
COPY deployment-targets ./deployment-targets
COPY scripts/git-askpass.sh /usr/local/bin/assistant-git-askpass

RUN pip install --no-cache-dir . \
    && chmod 0555 /usr/local/bin/assistant-git-askpass \
    && useradd --uid 10001 --create-home --home-dir /home/assistant assistant

USER assistant
CMD ["python", "-m", "app.worker"]
