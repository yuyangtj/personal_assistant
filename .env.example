ASSISTANT_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
ASSISTANT_GEMINI_TTS_VOICE=Achird
ASSISTANT_GEMINI_TTS_TIMEOUT_SECONDS=30
ASSISTANT_GEMINI_TTS_CACHE_ENTRIES=128
ASSISTANT_CODE_AGENT_ENABLED=false
ASSISTANT_CODE_AGENT_PROVIDERS=kimi,minimax-claude,codex
