ASSISTANT_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
ASSISTANT_GEMINI_TTS_VOICE=Achird
ASSISTANT_GEMINI_TTS_TIMEOUT_SECONDS=30
ASSISTANT_GEMINI_TTS_CACHE_ENTRIES=128
ASSISTANT_CONVERSATION_MODEL_PROVIDER=kimi
ASSISTANT_CONVERSATION_MODEL_FALLBACK_PROVIDER=auto
ASSISTANT_CONVERSATION_MODEL_BASE_URL=
ASSISTANT_CONVERSATION_MODEL=
ASSISTANT_CONVERSATION_MODEL_TIMEOUT_SECONDS=
