ASSISTANT_MANAGER_MODEL_PROVIDER=kimi
ASSISTANT_MANAGER_MODEL_FALLBACK_PROVIDER=auto
ASSISTANT_MANAGER_MODEL_BASE_URL=
ASSISTANT_MANAGER_MODEL=
