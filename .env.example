ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant
ASSISTANT_AUTO_CREATE_SCHEMA=false
ASSISTANT_WORKER_ID=worker-local
ASSISTANT_WORKER_POLL_INTERVAL_SECONDS=1
ASSISTANT_WORKER_LEASE_SECONDS=60
ASSISTANT_FAKE_EXECUTOR_DELAY_SECONDS=0.1
ASSISTANT_CAPABILITIES_DIRECTORY=capabilities
KIMI_API_KEY=
