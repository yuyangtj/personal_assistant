# Personal assistant architecture: what is built, partial, next, and later.
# Concept model (work items, chats, runs, timeline) is in assistant-core-model.d2.
direction: down

classes: {
  built: {style.fill: "#EAF4FF"; style.stroke: "#2563EB"; style.stroke-width: 2}
  partial: {style.fill: "#EAF4FF"; style.stroke: "#2563EB"; style.stroke-width: 2; style.stroke-dash: 4}
  next: {style.fill: "#FFF7E6"; style.stroke: "#D97706"; style.stroke-width: 2}
  later: {style.fill: "#F8FAFC"; style.stroke: "#94A3B8"; style.stroke-dash: 5; style.font-color: "#64748B"}
  ext: {style.fill: "#F5F3FF"; style.stroke: "#7C3AED"}
  layer: {style.fill: "#FFFFFF"; style.stroke: "#AAB4C3"; style.stroke-width: 2}
}

clients: "1 · Clients" {
  class: layer
  grid-columns: 5
  web: "Web console\nchats · work items · timeline · approvals" {class: built}
  android: "Android app\nchats · approvals (items: PR 4b)" {class: partial}
  voice: "Voice + avatar" {class: built}
  push: "Push notifications\nntfy" {class: built}
  gateway: "Caddy\nHTTPS · login" {class: built}
}

conversation: "2 · Conversation layer (FastAPI)" {
  class: layer
  grid-columns: 4
  sessions: "Chat sessions" {class: built}
  focus: "Focus resolver\n#mentions · focus chips" {class: built}
  context: "Context builder\nbrief + checklist + recent events + memory" {class: built}
  triage: "Intake & triage\nfast model + rules · keyword fallback" {class: built}
}

orchestrator: "3 · Orchestrator" {
  class: layer
  grid-columns: 3
  planner: "Run planner\ncapability routing + coding-runner ranking\n(tiers · agent profiles next)" {class: partial}
  queue: "Durable queue + workers\nleases · recovery" {class: built}
  policy: "Policy & approvals\nmerge · deploy (buy · device later)" {class: built}
  writeback: "Brief write-back\nquiet chat or finished run" {class: built}
  scheduler: "Scheduler\nreminders · routines (watches next)" {class: built}
  deployer: "Host deployer → Hetzner\nsystemd · tagged releases · rollback" {class: built}
}

tiers: "4 · Execution tiers — cheapest that can do the job" {
  class: layer
  grid-columns: 4
  t0: "T0 direct action\nchecklists · remember · reminders" {class: built}
  t1: "T1 chat agent\nKimi · MiniMax" {class: built}
  t2: "T2 research agent\nweb search (MCP tools next)" {class: partial}
  t3: "T3 coding workflow (isolated worker)\nKimi Code → MiniMax · repair pass\nsaved branch · PR → approve → merge" {class: built}
}

external: "5 · External" {
  class: layer
  grid-columns: 6
  llm: "Model providers\nKimi · MiniMax\n(Claude · Codex: escalation, next)" {class: ext}
  github: "GitHub" {class: ext}
  cloud: "Hetzner server" {class: ext}
  shops: "Shops / search" {class: later}
  bank: "Bank / transactions" {class: later}
  home: "Home devices" {class: later}
}

workspace: "Workspace — source of truth (PostgreSQL)" {
  class: layer
  grid-columns: 1
  spaces: "Spaces\npacks: general · coding · shopping" {class: partial}
  items: "Work items + briefs" {class: built}
  runs: "Runs (tasks table)" {class: built}
  events: "Event log → timeline" {class: built}
  memory: "Memory" {class: built}
}

catalog: "Capability catalog (YAML)" {
  class: layer
  grid-columns: 1
  workflows: "Workflows · coding runners\nrepositories · deploy targets" {class: built}
  runtime: "Provider health · cooldowns · outcomes" {class: built}
  profiles: "Agent profiles\nmodel + skills + tools + budget" {class: next}
  skills: "Skills" {class: next}
  tools: "Tools\nweb search (MCP servers next)" {class: partial}
}

legend: "Legend" {
  grid-columns: 4
  b: "Built" {class: built}
  p: "Partial" {class: partial}
  n: "Next" {class: next}
  l: "Later" {class: later}
}

# Main flow, top to bottom.
clients -> conversation: "chat"
conversation -> orchestrator: "start run"
orchestrator -> tiers: "dispatch"
tiers -> external: "models · GitHub"

# Shared state and capabilities on the sides.
conversation <-> workspace: "read briefs + memory · create / focus items"
tiers -> workspace: "events · run results"
orchestrator <-> workspace: "runs · write-back · deployments"
catalog -> orchestrator: "options to choose from"
catalog -> tiers: "runners · validation"
