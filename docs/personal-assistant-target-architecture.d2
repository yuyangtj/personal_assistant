# Personal assistant target architecture.
# Concept model (work items, chats, runs, timeline) is in assistant-core-model.d2.
direction: down

classes: {
  built: {style.fill: "#EAF4FF"; style.stroke: "#2563EB"; style.stroke-width: 2}
  new: {style.fill: "#FFF7E6"; style.stroke: "#D97706"; style.stroke-width: 2}
  later: {style.fill: "#F8FAFC"; style.stroke: "#94A3B8"; style.stroke-dash: 5; style.font-color: "#64748B"}
  ext: {style.fill: "#F5F3FF"; style.stroke: "#7C3AED"}
  layer: {style.fill: "#FFFFFF"; style.stroke: "#AAB4C3"; style.stroke-width: 2}
}

clients: "1 · Clients" {
  class: layer
  grid-columns: 4
  android: "Android app\nchats · items · timeline · approvals" {class: built}
  web: "Web console" {class: built}
  voice: "Voice + avatar" {class: built}
  push: "Push notifications" {class: new}
}

conversation: "2 · Conversation layer (behind FastAPI + auth)" {
  class: layer
  grid-columns: 4
  sessions: "Chat sessions" {class: built}
  focus: "Focus resolver\nwhich work items?" {class: new}
  context: "Context builder\nbrief + recent events + memory" {class: new}
  triage: "Intake & triage (cheap model)\nanswer · remember · attach · start run" {class: new}
}

orchestrator: "3 · Orchestrator" {
  class: layer
  grid-columns: 5
  planner: "Run planner\npick tier + agent profile" {class: built}
  queue: "Durable queue + workers" {class: built}
  policy: "Policy & approvals → push to phone\nmerge · deploy · buy · device" {class: built}
  scheduler: "Scheduler\nreminders · routines · watches" {class: new}
  writeback: "Brief write-back" {class: new}
}

tiers: "4 · Execution tiers — cheapest that can do the job" {
  class: layer
  grid-columns: 4
  t0: "T0 direct action\nno / tiny model" {class: new}
  t1: "T1 chat agent\nsmall model" {class: built}
  t2: "T2 tool agent\nmid model + skills + MCP" {class: new}
  t3: "T3 workflow\nworktree → runner → validate\n→ PR → approve → merge → deploy" {class: built}
}

external: "5 · External" {
  class: layer
  grid-columns: 6
  llm: "Model providers\nKimi · MiniMax · Claude · Codex" {class: ext}
  github: "GitHub" {class: ext}
  cloud: "Hetzner server" {class: ext}
  shops: "Shops / search" {class: later}
  bank: "Bank / transactions" {class: later}
  home: "Home devices" {class: later}
}

workspace: "Workspace — source of truth (PostgreSQL)" {
  class: layer
  grid-columns: 1
  spaces: "Spaces" {class: new}
  items: "Work items + briefs" {class: new}
  runs: "Runs (today's tasks table)" {class: built}
  events: "Event log → timeline" {class: built}
  memory: "Memory" {class: built}
}

catalog: "Capability catalog — from Space packs (YAML)" {
  class: layer
  grid-columns: 1
  profiles: "Agent profiles\nmodel + skills + tools + budget" {class: new}
  workflows: "Workflows" {class: built}
  skills: "Skills" {class: new}
  tools: "Tools / MCP servers" {class: new}
  runtime: "Provider health · quota · outcomes" {class: built}
}

legend: "Legend" {
  grid-columns: 3
  b: "Built" {class: built}
  n: "New in redesign" {class: new}
  l: "Later" {class: later}
}

# Main flow, top to bottom.
clients -> conversation: "chat"
conversation -> orchestrator: "start run"
orchestrator -> tiers: "dispatch"
tiers -> external: "providers · tools · deploy"

# Shared state and capabilities on the sides.
conversation <-> workspace: "read briefs + memory · create / attach items"
tiers -> workspace: "events · run results"
orchestrator <-> workspace: "runs · write-back · schedules"
catalog -> orchestrator: "options to choose from"
catalog -> tiers: "skills · MCP tools"
