{$ASSISTANT_DOMAIN} {
	encode zstd gzip

	# Health, the app manifest, icons, service worker, Android app-links file and privacy
	# policy are public: phones fetch assets before signing in, deployment checks the public
	# health path, and Google's OAuth consent screen links to the privacy policy. They hold
	# nothing private; everything else needs the console login.
	@private not path /health /manifest.webmanifest /sw.js /icons/* /.well-known/assetlinks.json /privacy
	basic_auth @private {
		{$ASSISTANT_WEB_USER} {$ASSISTANT_WEB_PASSWORD_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
