{$ASSISTANT_DOMAIN} {
	encode zstd gzip

	# The app manifest, icons and service worker are public: phones fetch them before
	# signing in, and Android builds the installed app from Google's servers. They hold
	# nothing private; everything else needs the console login.
	@private not path /manifest.webmanifest /sw.js /icons/*
	basic_auth @private {
		{$ASSISTANT_WEB_USER} {$ASSISTANT_WEB_PASSWORD_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
