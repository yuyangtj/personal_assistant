{$ASSISTANT_DOMAIN} {
	encode zstd gzip

	# The app manifest, icons, service worker and Android app-links file are public:
	# phones fetch them before signing in, and Android verifies them from its own side.
	# They hold nothing private; everything else needs the console login.
	@private not path /manifest.webmanifest /sw.js /icons/* /.well-known/assetlinks.json
	basic_auth @private {
		{$ASSISTANT_WEB_USER} {$ASSISTANT_WEB_PASSWORD_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
